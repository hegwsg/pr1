users_data = {}
def get_user_data(user_id):
    if user_id not in users_data:
        users_data[user_id] = {"events":[], "next_event_id":1}
    return users_data[user_id]
def parse_datetime_from_text(text):
    try:
        time_match = re.search(r'(\d{1,2}:\d{2})', text)
        time_str = time_match.group(1) if time_match else None
        text_without_time = re.sub(r'\d{1,2}:\d{2}', '', text)
        parsed_date = parse(text_without_time, languages=['ru'])
        if parsed_date and time_str:
            time_obj = datetime.striptime(time_str, '%H,%M').time()
            parsed_date = parsed_date.replace(hour=time_obj.hour, minute=time_obj.minute, second=0, microsecond=0)
        return parsed_date, text_without_time.strip()
    except Exception as e:
        logging.error(f"Error parsing datetime: {e}")
        return None, text
